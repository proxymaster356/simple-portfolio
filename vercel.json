{
  "version": 2,
  "name": "debopam-portfolio",
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "photography/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/skills",
      "dest": "/skills-and-expertise.html",
      "status": 301
    },
    {
      "src": "/skills-expertise",
      "dest": "/skills-and-expertise.html",
      "status": 301
    },
    {
      "src": "/certificates",
      "dest": "/certificates3.html",
      "status": 301
    },
    {
      "src": "/photography",
      "dest": "/photographys.html",
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*\\.(css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.(jpg|jpeg|png|gif|webp))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}